# GEMINI_API_KEY: required. Read only by the server; never exposed to the browser.
# In AI Studio this is injected from the Secrets panel. On Cloud Run, use Secret Manager.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: optional locally (defaults to 3000). Cloud Run sets this automatically.
# PORT=3000

# APP_URL: injected by AI Studio with the Cloud Run service URL (not used by the app itself).
APP_URL="MY_APP_URL"
